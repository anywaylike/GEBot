# Copy this file to .env and fill in only the provider variables you use.
# Do not commit .env or paste credentials into source files, issues, or logs.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GPT_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_ENABLED=true

ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=GLM-4.7

# Optional overrides.  Both paths may be absolute paths.
# GRAPHREASON_DATA_ROOT=./data
# GRAPHREASON_RESULTS_DIR=./outputs
# PRETRAIN_MODEL_PATH=google-bert/bert-base-uncased
